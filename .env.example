API_KEY=                          # Bearer que usará la plataforma
PROVIDER_BACKEND=anthropic_direct # anthropic_direct (producción) | vertex (alternativa, auth IAM)
GCP_PROJECT=                      # solo necesario para embeddings de search_profile o PROVIDER_BACKEND=vertex
VERTEX_REGION=us-east5            # región del modelo si PROVIDER_BACKEND=vertex
CLOUD_RUN_REGION=northamerica-south1
MODEL_ID=claude-sonnet-4-5
ANTHROPIC_API_KEY=                # console.anthropic.com — requerida con PROVIDER_BACKEND=anthropic_direct
EMBEDDING_MODEL=text-multilingual-embedding-002
RETRIEVAL_BACKEND=local           # local | bigquery
MAX_LOOP_ITERATIONS=6
STATE_TTL_SECONDS=3600
MAX_OUTPUT_TOKENS_CAP=4096
PROVIDER_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
ENV=dev
